# One key is enough. Stream events do not count against rate limits.
# Extra keys only help REST (collection names, usernames) and ONLY if they
# are from different OpenSea accounts. Keys on the same account share one bucket.
OPENSEA_API_KEY=
# OPENSEA_API_KEYS=key1,key2

# PORT=8788
# CHAIN=robinhood

# Optional cheap LLM for the vaporware Ask button. Leave unset and use Copy pack.
# VAPORWARE_API_KEY=
# OPENROUTER_API_KEY=
# VAPORWARE_MODEL=google/gemini-2.0-flash-lite
# VAPORWARE_AUTO=0
# Optional. Public mint wallet used only to check OpenSea drop eligibility.
# Do not put MINT_PRIVATE_KEY here. Watch-only, no auto-mint.
# MINT_WALLET_ADDRESS=0x...
# MINT_WATCH_WALLETS=0x...,0x...
